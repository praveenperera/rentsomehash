---
import { render } from "astro:content";
import { ArrowRightIcon, ArrowSquareOutIcon } from "@phosphor-icons/react";

import Footer from "@/components/Footer.astro";
import GuideListItem from "@/components/GuideListItem.astro";
import Header from "@/components/Header.astro";
import WarningsAccordion from "@/components/WarningsAccordion";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import {
  getFeaturedNodeGuide,
  getGuideHref,
  getGuides,
  getHashpowerGuide,
  getHashpowerGuides,
  getHomePage,
  getNodeGuides,
  getReadingTime,
} from "@/lib/content";
import SiteLayout from "@/layouts/SiteLayout.astro";

const home = await getHomePage();
const guides = await getGuides();
const nodeGuides = getNodeGuides(guides);
const hashpowerGuides = getHashpowerGuides(guides);
const featuredNodeGuide = getFeaturedNodeGuide(guides);
const pickHashGuide = getHashpowerGuide(guides, "pickhash");
const braiinsGuide = getHashpowerGuide(guides, "braiins");

if (!featuredNodeGuide || !pickHashGuide || !braiinsGuide) {
  throw new Error(
    "Expected a featured node guide plus PickHash and Braiins guides",
  );
}

const { Content } = await render(home);
---

<SiteLayout title={home.data.title} description={home.data.description} ogImage="/og.png">
  <Header guides={guides} currentPath={Astro.url.pathname} />

  <main class="pb-24">
    <section class="home-hero border-b border-border/70">
      <div class="mx-auto grid max-w-7xl gap-12 px-6 pt-28 pb-16 lg:grid-cols-[1.4fr_0.9fr] lg:px-8">
        <div class="space-y-8">
          <div class="space-y-4">
            <Badge variant="outline" className="home-hero-badge">{home.data.eyebrow}</Badge>
            <h1 class="max-w-4xl text-5xl font-heading font-medium tracking-[-0.08em] text-balance sm:text-6xl">
              Set up the node <span class="text-primary">first</span>. Choose how to rent the hash.
              Build blocks on <span class="text-primary">OCEAN</span>.
            </h1>
            <p class="max-w-2xl text-lg leading-8 text-foreground/76">
              {home.data.description}
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a href={home.data.primaryCtaHref} class={buttonVariants({ size: "lg" })}>
              {home.data.primaryCtaLabel}
            </a>
            <a href={home.data.secondaryCtaHref} class={buttonVariants({ variant: "outline", size: "lg" })}>
              {home.data.secondaryCtaLabel}
            </a>
            <a href="/calculator/" class={buttonVariants({ variant: "outline", size: "lg" })}>
              Estimate hashpower EV
            </a>
          </div>

          <div class="content-prose max-w-2xl">
            <Content />
          </div>
        </div>

        <Card className="home-hero-card self-start py-0" size="sm">
          <CardHeader className="gap-3 border-b border-border/70 py-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="text-[11px] uppercase tracking-[0.28em] text-primary/84">
                Step 1
              </p>
              <Badge variant="outline" className="border-primary/25 bg-primary/10 text-primary">
                Good default from zero
              </Badge>
            </div>
            <div class="space-y-2">
              <CardTitle className="text-base tracking-[-0.04em]">
                {featuredNodeGuide.data.title}
              </CardTitle>
              <CardDescription className="max-w-md text-sm leading-7 text-foreground/74">
                {featuredNodeGuide.data.summary}
              </CardDescription>
            </div>
          </CardHeader>
          <CardContent className="py-5">
            <dl class="grid gap-4 sm:grid-cols-2">
              <div class="space-y-1">
                <dt class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
                  Setup
                </dt>
                <dd class="text-sm text-foreground/82">{featuredNodeGuide.data.setupType}</dd>
              </div>
              <div class="space-y-1">
                <dt class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
                  Read time
                </dt>
                <dd class="text-sm text-foreground/82">{getReadingTime(featuredNodeGuide)}</dd>
              </div>
              <div class="space-y-1">
                <dt class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
                  Then choose
                </dt>
                <dd class="text-sm text-foreground/82">PickHash or Braiins</dd>
              </div>
              <div class="space-y-1">
                <dt class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
                  Goal
                </dt>
                <dd class="text-sm text-foreground/82">Get a public DATUM hostname ready for rented rigs</dd>
              </div>
            </dl>
          </CardContent>
          <CardFooter className="justify-between gap-4 border-t border-border/70 py-4">
            <p class="text-xs leading-6 text-foreground/66">
              Use this first, then bring its endpoint into either rental guide
            </p>
            <a
              href={getGuideHref(featuredNodeGuide)}
              class="inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors hover:text-primary/80"
            >
              Open the VPS guide
              <ArrowRightIcon className="size-4" aria-hidden="true" />
            </a>
          </CardFooter>
        </Card>
      </div>
    </section>

    <section id="workflow" class="home-workflow-section mx-auto max-w-7xl px-6 py-16 lg:px-8">
      <div class="space-y-8">
        <div class="space-y-4">
          <p class="text-[11px] uppercase tracking-[0.28em] text-muted-foreground">
            What you are actually doing
          </p>
          <h2 class="max-w-lg text-3xl font-heading tracking-[-0.06em]">
            This is a 2-step workflow
          </h2>
          <p class="max-w-lg text-base leading-8 text-foreground/74">
            First you finish one node setup guide and make DATUM reachable. Then you choose a
            self-hosted controller or hosted order book and point the rented hashpower at that endpoint.
          </p>
        </div>

        <div class="grid gap-4 xl:grid-cols-2">
          {home.data.highlights.map((highlight, index) => (
            <a
              href={index === 0 ? "/#node-guides" : "/#hashpower-guides"}
              class:list={[
                "home-step-card relative isolate block overflow-hidden border px-5 py-6 shadow-[0_1px_0_rgba(15,23,42,0.04)] transition-all",
                index === 0 ? "home-step-card home-step-card-node" : "home-step-card home-step-card-hashpower",
              ]}
            >
              <span class="home-step-number" aria-hidden="true">
                0{index + 1}
              </span>
              <div class="relative grid gap-4 md:grid-cols-[8rem_1fr]">
                <p class="pt-1 text-[11px] uppercase tracking-[0.24em] text-muted-foreground">
                  Step 0{index + 1}
                </p>
                <div class="space-y-2">
                  <h3 class="text-lg font-heading tracking-[-0.04em]">
                    {highlight.title}
                  </h3>
                  <p class="text-sm leading-7 text-foreground/74">
                    {highlight.body}
                  </p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="node-guides" class="home-stage-section home-stage-section-node border-y border-border/70">
      <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
        <div class="space-y-8">
          <div class="space-y-5">
            <p class="text-[11px] uppercase tracking-[0.28em] text-muted-foreground">
              Step 1
            </p>
            <h2 class="text-3xl font-heading tracking-[-0.06em]">
              Choose the node setup that matches your situation
            </h2>
            <p class="max-w-3xl text-base leading-8 text-foreground/74">
              The VPS guide is the best default if you are starting from zero and want the path that
              fits the most people. If you already have StartOS or Umbrel running at home, it usually
              makes more sense to use that instead.
            </p>
          </div>

          <div class="space-y-4">
            {nodeGuides.map((guide) => (
              <GuideListItem guide={guide} />
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="hashpower-guides" class="home-stage-section home-stage-section-hashpower border-y border-border/70">
      <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
        <div class="space-y-8">
          <div class="space-y-5">
            <p class="text-[11px] uppercase tracking-[0.28em] text-muted-foreground">
              Step 2
            </p>
            <h2 class="text-3xl font-heading tracking-[-0.06em]">
              Choose the rental model that fits you
            </h2>
            <p class="max-w-3xl text-base leading-8 text-foreground/74">
              Both paths can point hashpower at your DATUM endpoint. The difference is how orders are
              operated, settled, and stopped. Compare the trade-offs before funding either account.
            </p>
          </div>

          <div class="grid gap-5 lg:grid-cols-2">
            {hashpowerGuides.map((guide) => (
              <Card className="home-hashpower-option h-full gap-0 py-0">
                <CardHeader className="gap-4 border-b border-border/70 py-6">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <Badge variant="outline">
                      {guide.data.provider === "pickhash" ? "Self-hosted" : "Hosted"}
                    </Badge>
                    <p class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
                      {getReadingTime(guide)}
                    </p>
                  </div>
                  <div class="space-y-2">
                    <CardTitle className="text-xl tracking-[-0.04em]">
                      {guide.data.navLabel}
                    </CardTitle>
                    <CardDescription className="text-sm leading-7 text-foreground/74">
                      {guide.data.approach}
                    </CardDescription>
                  </div>
                </CardHeader>
                <CardContent className="flex-1 space-y-6 py-6">
                  <div class="space-y-2">
                    <p class="text-[11px] uppercase tracking-[0.22em] text-primary">
                      Best for
                    </p>
                    <p class="text-sm leading-7 text-foreground/82">
                      {guide.data.bestFor}
                    </p>
                  </div>
                  <div class="space-y-3">
                    <p class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground">
                      Know before you choose
                    </p>
                    <ul class="space-y-3">
                      {guide.data.tradeoffs.map((tradeoff) => (
                        <li class="flex gap-3 text-sm leading-6 text-foreground/72">
                          <span class="mt-2 size-1.5 shrink-0 bg-primary/70" aria-hidden="true"></span>
                          <span>{tradeoff}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </CardContent>
                <CardFooter className="border-t border-border/70 py-5">
                  <a
                    href={getGuideHref(guide)}
                    class={buttonVariants({ size: "lg" })}
                  >
                    Open {guide.data.navLabel} guide
                    <ArrowRightIcon className="size-4" aria-hidden="true" />
                  </a>
                </CardFooter>
              </Card>
            ))}
          </div>

          <div class="border border-primary/30 bg-primary/10 p-5">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div class="space-y-2">
                <p class="text-[11px] uppercase tracking-[0.24em] text-primary">
                  See it before you run it
                </p>
                <p class="max-w-2xl text-sm leading-7 text-foreground/76">
                  Watch the full installation and first-rental walkthrough, then use PickHash's
                  DRY-RUN mode to rehearse your own session without spending sats.
                </p>
              </div>
              <a
                href="https://www.youtube.com/watch?v=QODtoBSir88"
                target="_blank"
                rel="noopener noreferrer"
                class={buttonVariants({ size: "lg" })}
              >
                Watch PickHash tutorial
                <ArrowSquareOutIcon className="size-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-warning-section border-y border-border/70">
      <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
          <div class="space-y-4">
            <p class="text-[11px] uppercase tracking-[0.28em] text-muted-foreground">
              Don&apos;t skip these
            </p>
            <h2 class="text-3xl font-heading tracking-[-0.06em]">
              These are the parts people usually get wrong
            </h2>
          </div>

          <WarningsAccordion client:visible warnings={home.data.warnings} />
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-8 lg:px-8">
      <div class="home-final-cta flex flex-wrap items-center justify-between gap-4 border-t border-border/70 pt-8">
        <div class="space-y-1">
          <p class="text-[11px] uppercase tracking-[0.24em] text-muted-foreground">
            Ready to start
          </p>
          <p class="text-sm text-foreground/74">
            Start with the node guide that matches the setup you actually want to run
          </p>
        </div>
        <a href="/#node-guides" class={buttonVariants({ size: "lg" })}>
          Compare node guides
          <ArrowSquareOutIcon className="size-4" aria-hidden="true" />
        </a>
      </div>
    </section>
  </main>

  <Footer guides={guides} />
</SiteLayout>
